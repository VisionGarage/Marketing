# ─────────────────────────────────────────────────────────────
# VisionGarage Knowledge Base — variabile de mediu
# Copiază în `.env.local` și completează din proiectul Supabase (Settings → API)
# ─────────────────────────────────────────────────────────────

# Public (expuse în browser) — din Supabase: Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# SECRET — NU se expune niciodată în client. Folosit doar în rute server / worker.
# Supabase: Settings → API → service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# URL-ul aplicației (pentru magic link redirect). Local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Bucket-uri de Storage (create în Supabase Storage, PRIVATE)
NEXT_PUBLIC_ATTACHMENTS_BUCKET=attachments
PROCESSING_BUCKET=processing
NEXT_PUBLIC_PROCESSING_BUCKET=processing

# Securitate
SIGNED_URL_TTL_SECONDS=120          # durata URL-urilor semnate pentru atașamente
RATE_LIMIT_PER_MINUTE=120           # request-uri/minut/user pe API
ANOMALY_OPEN_THRESHOLD_PER_HOUR=300 # peste acest prag de proceduri deschise/oră => flag

# ─── Stripe (CUSĂTURĂ pregătită — NU activă în v1) ───
# Completează când integrezi plăți. Vezi src/lib/billing/stripe-seam.ts
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
